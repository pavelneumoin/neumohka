# VK ID app id (https://vk.com/apps?act=manage). Публичный — пойдёт в JS.
NEXT_PUBLIC_VK_APP_ID=54586483

# Доверенный Redirect URL VK ID app — должен совпадать с настройками VK.
NEXT_PUBLIC_VK_REDIRECT_URL=https://neumoshka.ru/api/auth/vk/callback

# Сервисный ключ VK. Только для server-side вызовов VK API. Не коммитить!
VK_SERVICE_TOKEN=

# Защищённый ключ VK ID app. Зарезервирован для будущих server-flows. Не коммитить!
VK_SECURE_KEY=
