# Публичный адрес сайта для sitemap и Open Graph.
NEXT_PUBLIC_SITE_URL=https://neumoshka.ru

# Корень постоянных data/store и private/library. Локально не задавайте:
# тогда используется корень проекта. Production-значение задаёт PM2.
# NEUMOSHKA_STORAGE_ROOT=/opt/neumoshka-web

# Локальный источник для ручного `npm run sync -- --apply`.
NEUMOSHKA_LIBRARY_SOURCE=E:/YA/YandexDisk/Lessons/library

# Необязательно: абсолютный путь к Poppler pdftoppm для генерации preview.
# PDFTOPPM_PATH=C:/tools/poppler/Library/bin/pdftoppm.exe
